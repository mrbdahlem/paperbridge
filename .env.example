# BentoPDF Environment Variables
# Copy this file to .env.production and configure as needed.

# CORS Proxy for digital signature certificate chain fetching
VITE_CORS_PROXY_URL=
VITE_CORS_PROXY_SECRET=

# WASM Module URLs
# Pre-configured defaults enable advanced PDF features out of the box.
# For air-gapped / offline deployments, point these to your internal server (e.g., /wasm/pymupdf/).
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@bentopdf/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@bentopdf/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/

# OCR assets (optional)
# Set all three together for self-hosted or air-gapped OCR.
# Leave empty to use Tesseract.js runtime defaults.
VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

# Default UI language (build-time)
# Supported: en, ar, be, fr, de, es, zh, zh-TW, vi, tr, id, it, pt, nl, da, ko, sv, ru
VITE_DEFAULT_LANGUAGE=

# Local development server ports
# Defaults: dev server on 5173, preview server on 4173.
# Both bind to localhost by default. Devcontainers set these host variables
# to 0.0.0.0 so forwarded ports are reachable from the host machine.
# VITE_DEV_HOST=0.0.0.0
# VITE_PREVIEW_HOST=0.0.0.0
# Set VITE_DEV_PORT in .env.development.local or your shell.
# Set VITE_PREVIEW_PORT in .env.local, .env.production.local, or your shell,
# but keep it commented here so a copied .env.production file does not shadow
# preview overrides from .env.local.
# VITE_DEV_PORT=5174
# VITE_PREVIEW_PORT=4174

# Optional high-memory dev mode
# Enables broader Vite dependency discovery/pre-bundling for heavier tool-page development.
# JSZip is pre-bundled by default for the ScribbledPage assignment flow.
VITE_ENABLE_DEP_OPTIMIZER=

# Public site URL used for generated sitemap, localized canonical URLs, and SEO audit checks.
# Defaults to https://scribbled.page.
SITE_URL=

# ScribbledPage: QR code scan URL base (build-time)
# Defaults to the server's own origin at runtime: https://<host>/p/{token}
# Set this to use a short/dedicated scan domain instead.
VITE_QR_BASE_URL=

# Server runtime
# Render injects PORT for the Fastify web service. Local npm start defaults to 10000.
# PORT=10000
# HOST=0.0.0.0
# LOG_LEVEL=info

# Neon Postgres
# Server-only. Never expose this through VITE_* variables or browser code.
# Use Neon's pooled connection string for deployed app runtime.
DATABASE_URL=
# Server-only. Direct/non-pooled Neon connection string for migration jobs only.
DATABASE_MIGRATION_URL=
# Optional migration runner overrides. Defaults are server/migrations and schema_migrations.
# DATABASE_MIGRATIONS_DIR=server/migrations
# DATABASE_MIGRATIONS_TABLE=schema_migrations
# Local short-lived Neon branch automation. Keep NEON_API_KEY out of committed env files.
# npm run db:branch:create derives a Neon branch from the current git branch,
# creates branch-local runtime/migration roles, and writes DATABASE_URL plus
# DATABASE_MIGRATION_URL to .env.local.
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_PARENT_BRANCH_ID=
# NEON_DATABASE_NAME=neondb
# NEON_BRANCH_PREFIX=dev
# NEON_BRANCH_GUARD=warn
# NEON_RUNTIME_ROLE_NAME=scribbledpage_dev_app
# NEON_MIGRATION_ROLE_NAME=scribbledpage_dev_migration
# Optional Postgres.js pool settings. Defaults are suitable for Render's Node service.
# DATABASE_POOL_MAX=5
# DATABASE_IDLE_TIMEOUT_SECONDS=20
# DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Google OAuth
# Server-only. Create credentials in Google Cloud Console for the deployed app origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# Server session signing
# Server-only. Use a long random value in every deployed environment.
# Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
